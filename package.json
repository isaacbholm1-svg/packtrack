{
  "name": "packtrack",
  "version": "0.1.0",
  "description": "Track many packages across many carriers, and import shipments from store emails and order pages. Runs in the browser (GitHub Pages); optional local helper for email sync.",
  "type": "module",
  "main": "helper/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env helper/index.js",
    "dev": "node --env-file-if-exists=.env --watch helper/index.js",
    "test": "node --test test/*.test.js",
    "serve": "npx --yes serve@14 public"
  },
  "engines": {
    "node": ">=22.9"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0",
    "imapflow": "^2.12.2",
    "mailparser": "^3.15.0"
  }
}
