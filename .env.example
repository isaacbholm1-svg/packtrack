# Copy to .env and fill in what you need. Everything here can also be set in the app's Settings.

PORT=3000
HOST=127.0.0.1

# auto | 17track | ship24 | aftership | mock | none
TRACKING_PROVIDER=auto
SEVENTEENTRACK_API_KEY=
SHIP24_API_KEY=
AFTERSHIP_API_KEY=
POLL_MINUTES=60

# Email sync (read-only). Gmail needs an app password.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
IMAP_SINCE_DAYS=30
IMAP_MINUTES=15
