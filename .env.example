# Settings for the optional PackTrack helper (npm start). Copy to .env.
# Tracking API keys are NOT set here: enter them in the app's Settings.

PORT=3000
HOST=127.0.0.1

# Web pages allowed to use this helper besides http://localhost:3000.
# Put your GitHub Pages address here, e.g. https://yourname.github.io
HELPER_ORIGINS=

# Email sync (read-only). Gmail: imap.gmail.com + an app password.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
IMAP_SINCE_DAYS=30
